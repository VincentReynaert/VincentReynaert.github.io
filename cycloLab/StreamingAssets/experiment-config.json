  "texts": {
    "generalInstructions": "Dans cette expérience, vous allez parcourir un environnement urbain à vélo.\nVous commencerez par une courte phase de prise en main. Les consignes des essais vous seront ensuite présentées.",
    "neutralEquipmentNote": "Certains éléments visuels liés au vélo, à l’équipement ou à l’environnement peuvent apparaître à l’écran.",
    "tutorialIntroduction": "Vous allez maintenant réaliser une courte phase de prise en main.\nLes consignes apparaîtront progressivement à l’écran pendant l’exercice.\nSuivez simplement les indications au fur et à mesure.",
    "tutorialFailureMessage": "La phase de prise en main n’a pas pu être validée. Merci pour votre participation.",
    "endMessage": "L’expérience est terminée. Merci pour votre participation.",
    "trialInstructions": "Dans cette expérience, vous allez parcourir un environnement urbain à vélo.\nVotre tâche est de vous déplacer naturellement, comme vous le feriez dans vos trajets habituels, tout en observant votre environnement.\nRégulièrement, de courtes questions vous seront posées sur ce que vous venez de voir et de ressentir."
  },
  "tutorial": {
    "inputMode": "HoldToPedalMode",
    "maxTutorialDurationSeconds": 360,
    "requiredSuccessfulStops": 1,
    "requiredTargetZonesReached": 3,
    "stopSpeedThreshold": 0.2,
    "requiredStopDuration": 1,
    "allowRetry": true,
    "maxAttempts": 2,
    "neutralWaitDurationSeconds": 1.5,
    "objectives": [
      {
        "objectiveId": "move",
        "instruction": "Avancez jusqu’à la zone bleue.",
        "objectiveType": "ReachZone",
        "zoneId": "tutorial_zone_move",
        "waitDurationSeconds": 1
      },
      {
        "objectiveId": "stop",
        "instruction": "Arrêtez-vous dans la zone verte.",
        "objectiveType": "StopInZone",
        "zoneId": "tutorial_zone_stop",
        "waitDurationSeconds": 1
      },
      {
        "objectiveId": "wait",
        "instruction": "Attendez le signal en restant dans la zone verte.",
        "objectiveType": "WaitForSignal",
        "zoneId": "tutorial_zone_stop",
        "waitDurationSeconds": 1.5
      },
      {
        "objectiveId": "restart",
        "instruction": "Repartez jusqu’à la zone orange.",
        "objectiveType": "ReachZone",
        "zoneId": "tutorial_zone_restart",
        "waitDurationSeconds": 1
      },
      {
        "objectiveId": "finish",
        "instruction": "Enfin atteignez la zone violette.",
        "objectiveType": "ReachFinalZone",
        "zoneId": "tutorial_zone_final",
        "waitDurationSeconds": 1
      }
    ]
  },
